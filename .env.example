# Required Azure OpenAI settings
OPENAI_API_KEY=your-azure-openai-api-key
BASE_URL=https://your-resource.openai.azure.com
API_VERSION=2024-08-01-preview
DEPLOYMENT_NAME=gpt-4o-mini

# Optional model overrides
MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_TOKENS=3000

# Optional: use separate deployments/settings for the two annotators
# ANNOTATOR_1_DEPLOYMENT=gpt-4o-mini
# ANNOTATOR_2_DEPLOYMENT=gpt-4.1
# ANNOTATOR_1_TEMPERATURE=0.1
# ANNOTATOR_2_TEMPERATURE=0.4

# Retry and timeout settings
LLM_INVOKE_TIMEOUT_SEC=90
LLM_MAX_RETRIES=10
LLM_BASE_SLEEP=1
ANNOTATOR_INVOKE_TIMEOUT_SEC=60
ANNOTATOR_MAX_RETRIES=10
ANNOTATOR_BASE_SLEEP=1
ANNOTATOR_INTER_CALL_SLEEP=1
ANNOTATOR_HEARTBEAT_INTERVAL_SEC=10

# Optional Gemini client (not required by the default pipeline)
# GOOGLE_API_KEY=your-google-api-key
# GEMINI_MODEL_A1=gemini-2.5-flash
